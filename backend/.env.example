# Copy to .env and adjust. Loaded by your process manager / shell (export …).
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins for production (CORS is open only while DEBUG=true)
DJANGO_CORS_ORIGINS=https://example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# Password used by `manage.py seed_demo` for the demo users (default: admin)
DJANGO_SEED_ADMIN_PASSWORD=admin
